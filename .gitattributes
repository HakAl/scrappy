# Normalize line endings: store LF in the repo AND check out LF on every
# platform. eol=lf (not bare text=auto) is deliberate: text=auto alone checks
# out native CRLF on Windows, which the Windows-synced checkout then drags back
# as a phantom 600-file diff. Forcing LF in the working tree kills that churn at
# the root. Genuinely-CRLF files opt back in below (*.ps1).
* text=auto eol=lf

# Windows-native scripts must stay CRLF.
*.ps1 text eol=crlf

# Shell scripts must stay LF even when checked out on Windows.
*.sh text eol=lf

# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads
