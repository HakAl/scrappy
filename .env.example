# Multi-Provider LLM Agent Team - Environment Variables
# Copy this file to .env and fill in your API keys

# Primary provider (RECOMMENDED - 14,400 requests/day)
CEREBRAS_API_KEY=your_cerebras_api_key_here
# Get key: https://cloud.cerebras.ai

# Secondary provider (7,000 requests/day)
GROQ_API_KEY=your_groq_api_key_here
# Get key: https://console.groq.com

# Additional providers (optional)
GEMINI_API_KEY=your_gemini_api_key_here
# Get key: https://aistudio.google.com
# Note: Auto-fallback between models, ~1,650 requests/day total

COHERE_API_KEY=your_cohere_api_key_here
# Get key: https://dashboard.cohere.com
# WARNING: Trial key limited to 1,000 calls/month - use sparingly!

# Providers we investigated but are NOT recommended:
# HUGGINGFACE_API_KEY - Only $0.10/month credits, not viable
# SAMBANOVA_API_KEY - Only 40 requests/day, not viable
# OPENROUTER_API_KEY - Free models unreliable (upstream rate limits)
# GITHUB_API_KEY - crashes the agent after ~10 LLM calls

# =============================================================================
# Langfuse Observability (optional, self-hosted)
# =============================================================================
# Start Langfuse with: docker-compose up -d
# Then create an API key at http://localhost:3000

LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...