/* Scrappy CLI Textual Theme
 * Theme-aligned color variables - must match ScrappyTheme defaults
 * See src/infrastructure/theme.py for the authoritative theme definitions
 */

/* Background colors */
$surface: #1e1e1e;
$surface-alt: #2d2d2d;

/* Text colors */
$text: #d4d4d4;
$text-muted: #808080;

/* Semantic foreground colors - aligned with ScrappyTheme */
$primary: #00ffff;    /* cyan - borders, headers, info text, input prompt */
$accent: #ffcc00;     /* yellow/orange - commands, interactive elements, capture mode */
$success: #00ff00;    /* green - positive states */
$warning: #ffcc00;    /* yellow - caution states */
$error: #ff0000;      /* red - errors */
$info: #0080ff;       /* blue - informational panels, thinking state */

/* Main screen layout */
Screen {
    background: $surface;
    layout: vertical;
}

/* Scrollable output container */
#output_container {
    height: 1fr;
    overflow-y: auto;
}

/* Main scrollable output (includes banner as content) */
RichLog {
    background: $surface;
    color: $text;
    border: none;
    padding: 0 1 1 1;
    height: 100%;
    scrollbar-size-vertical: 0;
}

/* Input container at bottom */
#input_container {
    layout: horizontal;
    height: auto;
    background: $surface;
    padding: 1;
}

/* Input prompt character - uses primary (cyan) for normal mode */
#input_prompt {
    width: 2;
    content-align: center middle;
    color: $primary;
}

/* User input field - TextArea for multiline support */
TextArea {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 5;
    border: none;
    background: $surface;
}

/* TextArea internal gutter (line numbers area) */
TextArea > .text-area--gutter {
    background: $surface;
}

/* TextArea internal cursor line highlight */
TextArea > .text-area--cursor-line {
    background: $surface;
}

/* TextArea placeholder styling */
TextArea > .text-area--placeholder {
    color: $text-muted !important;
}

/* TextArea cursor styling */
TextArea > .text-area--cursor {
    color: $text !important;
}

/* Status bar - only visible when components active
   NOTE: Uses height: 0 as fallback for Textual display: none issues */
#status_bar {
    height: 0;
    max-height: 30%;
    overflow: hidden;
    background: $surface-alt;
    padding: 0;
    display: none;
}

#status_bar.show {
    display: block;
    height: auto;
    padding: 1;
    overflow-x: auto;
    overflow-y: auto;
}

#status_content {
    width: 100%;
    height: auto;
}

/* Progress indicator styling */
#progress_indicator {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

#progress_indicator Label {
    width: 30;
    content-align: left middle;
}

#progress_indicator ProgressBar {
    width: 1fr;
}

/* Token counter styling */
#token_counter {
    width: 100%;
    content-align: right middle;
    color: $text-muted;
}

/* Capture mode visual feedback - accent (yellow/orange) prompt indicates waiting for response */
#input_container.capture-mode #input_prompt {
    color: $accent;
}

/* Prompt display styling - shows prompts/questions near input */
#prompt_display {
    width: 100%;
    color: $accent;
    padding: 0 1;
}
